{
  "name": "kinematic",
  "version": "0.1.0",
  "private": true,
  "description": "An activity component for React: one live surface for uploads, agents, music, calls and timers. Installs with the shadcn CLI.",
  "license": "MIT",
  "author": "Saumya Das (https://saumyadas.dev)",
  "homepage": "https://kinematic.design",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Soumyadas15/kinematic.git"
  },
  "bugs": "https://github.com/Soumyadas15/kinematic/issues",
  "keywords": [
    "react",
    "shadcn",
    "shadcn-registry",
    "activity",
    "toast",
    "motion",
    "nextjs",
    "tailwindcss"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@8.11.0",
  "scripts": {
    "dev": "next dev",
    "build": "pnpm registry:build && next build",
    "start": "next start",
    "registry:build": "rm -rf public/r && shadcn build",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm knip && pnpm test && pnpm check:og && pnpm build && pnpm check:size",
    "og": "node scripts/og.mjs",
    "registry:smoke": "bash scripts/registry-smoke.sh",
    "e2e": "playwright test",
    "check:og": "node scripts/check-og.mjs",
    "check:size": "node scripts/check-size.mjs"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "fumadocs-core": "^16.17.8",
    "fumadocs-mdx": "^15.4.10",
    "lucide-react": "^1.63.0",
    "motion": "^14.7.1",
    "next": "16.4.3",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/mdx": "^2.0.14",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "jsdom": "^30.1.3",
    "knip": "5",
    "playwright-core": "1.64.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^6",
    "vitest": "^5.0.5"
  }
}
